  },
  {
    "id": "TW-02", "category": "StepwellTwin",
    "name": "List all epochs",
    "method": "GET", "path": "/api/v1/stepwell/epochs",
    "expect_status": 200,
    "expect_type": "list",
    "expect_min_length": 4
  },
  {
    "id": "TW-03", "category": "StepwellTwin",
    "name": "Single epoch (1498)",
    "method": "GET", "path": "/api/v1/stepwell/epochs/1498",
    "expect_status": 200,
    "expect_keys": ["year", "label", "materials", "water"]
  },
  {
    "id": "TW-04", "category": "StepwellTwin",
    "name": "Solar position noon",
    "method": "GET", "path": "/api/v1/stepwell/sun?hour=12&date=2026-06-21",
